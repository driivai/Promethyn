# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Runtime artifacts (local registry and ledger)
.prometheus/
*.db

# Editor / OS noise
.DS_Store
*.swp

# Local secrets / tool config (NEVER commit). The settings pattern is a glob
# (any tool's per-machine settings.local.json, wherever it lives) so this file
# itself stays free of tool-vendor tokens (see scripts/check_hygiene.py).
**/settings.local.json
.env
.env.*

# Evidence that the type gate EXECUTED in this job (scripts/type_gate.py).
# Never committed: a checked-in receipt would satisfy the receipt check
# without the gate running.
type-gate-receipt.json
